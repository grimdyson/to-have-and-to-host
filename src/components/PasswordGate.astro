---
import { wedding } from "@/data/site";

interface Props {
  enabled?: boolean;
}

const { enabled = true } = Astro.props;
const passwordHash = String(import.meta.env.PUBLIC_SITE_PASSWORD_HASH ?? "").trim().toLowerCase();
const isConfigured = /^[a-f0-9]{64}$/.test(passwordHash);
const isLocalDemo = import.meta.env.DEV && passwordHash === "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08";
---

{
  enabled && (
    <section
      class="password-gate"
      data-password-gate
      data-password-hash={passwordHash}
      data-password-configured={String(isConfigured)}
      aria-label="Private website entry"
    >
      <form class="password-card" data-password-form novalidate>
        <p class="eyebrow">Private celebration</p>
        <div class="ornament" aria-hidden="true">***</div>
        <h1>{wedding.couple.partnerOne}<span>and</span>{wedding.couple.partnerTwo}</h1>
        {
          isConfigured ? (
            <>
              <label for="site-password">Enter the password from your invitation</label>
              {isLocalDemo && <p class="password-demo">Local demo password: <code>test</code></p>}
              <div class="password-row">
                <input id="site-password" name="password" type="password" autocomplete="current-password" required />
                <button type="submit">Enter</button>
              </div>
            </>
          ) : (
            <div class="password-setup-message" role="alert">
              <h2>Password setup required</h2>
              <p>Add a valid <code>PUBLIC_SITE_PASSWORD_HASH</code> before previewing or publishing this website.</p>
              <p>Follow the password stage in <code>SETUP.md</code>.</p>
            </div>
          )
        }
        <p class="password-message" data-password-message aria-live="polite"></p>
      </form>
      <noscript>
        <p class="password-noscript">JavaScript is required to enter this private website.</p>
      </noscript>
    </section>
  )
}

<script>
  const gate = document.querySelector<HTMLElement>("[data-password-gate]");

  if (gate) {
    const expectedHash = gate.dataset.passwordHash ?? "";
    const isConfigured = gate.dataset.passwordConfigured === "true";
    const form = gate.querySelector<HTMLFormElement>("[data-password-form]");
    const passwordInput = gate.querySelector<HTMLInputElement>('[name="password"]');
    const message = gate.querySelector<HTMLElement>("[data-password-message]");
    const cookieName = "wedding-site-unlocked";
    const cookieValue = expectedHash.slice(0, 16);

    const hasUnlockCookie = () =>
      document.cookie
        .split(";")
        .map((cookie) => cookie.trim())
        .includes(`${cookieName}=${cookieValue}`);

    const hashText = async (value: string) => {
      const bytes = new TextEncoder().encode(value);
      const digest = await crypto.subtle.digest("SHA-256", bytes);
      return Array.from(new Uint8Array(digest))
        .map((byte) => byte.toString(16).padStart(2, "0"))
        .join("");
    };

    const unlock = ({ moveFocus = true, resetScroll = true } = {}) => {
      const secure = window.location.protocol === "https:" ? "; secure" : "";
      document.cookie = `${cookieName}=${cookieValue}; max-age=2592000; path=/; samesite=lax${secure}`;
      document.body.removeAttribute("data-password-locked");
      gate.hidden = true;
      if (moveFocus) document.querySelector<HTMLElement>("#main-content")?.focus({ preventScroll: true });
      if (resetScroll) window.scrollTo(0, 0);
    };

    if (isConfigured && hasUnlockCookie()) unlock({ moveFocus: false, resetScroll: false });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!isConfigured || !passwordInput) return;

      if (!passwordInput.value) {
        if (message) message.textContent = "Enter the password to continue.";
        passwordInput.focus();
        return;
      }

      const actualHash = await hashText(passwordInput.value);
      if (actualHash === expectedHash) {
        unlock();
      } else {
        if (message) message.textContent = "That password did not match. Please try again.";
        passwordInput.select();
      }
    });
  }
</script>
